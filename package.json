{
  "name": "idlebot",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @idlebot/api dev",
    "dev:api": "pnpm --filter @idlebot/api dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "db:push": "pnpm --filter @idlebot/api db:push",
    "db:seed": "pnpm --filter @idlebot/api db:seed",
    "accept": "pnpm --filter @idlebot/api accept"
  }
}
