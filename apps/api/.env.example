# Local Postgres, or a Neon URL. A host containing neon.tech uses the Neon serverless driver.
# On Vercel, use the Neon pooled connection string (the hostname contains -pooler).
DATABASE_URL=postgres://grokbot:grokbot@127.0.0.1:5432/grokbot
# openssl rand -base64 32 — do not commit a real secret
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Site origin, no path. Local API: http://127.0.0.1:3000
# Vercel production: https://<project>.vercel.app
# Leave unset on Preview; that deployment uses https://$VERCEL_URL
BETTER_AUTH_URL=http://127.0.0.1:3000
# mock (default) or http. This deploy keeps mock. Real mail is later.
RELAY_MODE=mock
RELAY_INBOUND_ADDRESS=inbound@mail.grokbot.com
# Set this to enable POST /api/webhooks/inbound-email. Unset returns 503.
# Not required for the Vercel + Neon deploy.
# INBOUND_EMAIL_SECRET=
# Optional real outbound relay. RELAY_MODE=http posts the same payload.
# RELAY_HTTP_URL=
# Extra browser origins for CORS and Better Auth, comma-separated.
# Localhost ports (including http://127.0.0.1:5190) stay allowed.
# Vercel also trusts VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, and VERCEL_BRANCH_URL.
# Do not set those VERCEL_* names yourself; the platform injects them.
# TRUSTED_ORIGINS=https://idlebot.example
# DB_DRIVER=neon
