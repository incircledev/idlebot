# Supabase Postgres. Dashboard > Connect > Transaction pooler (port 6543). Secret: never commit.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase Auth. Both are public values (Dashboard > Project Settings > API Keys).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Site origin, no path, used for CORS. Local API: http://127.0.0.1:3000
# Vercel production: https://<project>.vercel.app
BETTER_AUTH_URL=http://127.0.0.1:3000
# mock (default) or http. This deploy keeps mock. Real mail is later.
RELAY_MODE=mock
RELAY_INBOUND_ADDRESS=inbound@mail.grokbot.com
# Set this to enable POST /api/webhooks/inbound-email. Unset returns 503.
# Not required for the Vercel + Neon deploy.
# INBOUND_EMAIL_SECRET=
# Optional real outbound relay. RELAY_MODE=http posts the same payload.
# RELAY_HTTP_URL=
# Extra browser origins for CORS, comma-separated.
# Localhost ports (including http://127.0.0.1:5190) stay allowed.
# Vercel also trusts VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, and VERCEL_BRANCH_URL.
# Do not set those VERCEL_* names yourself; the platform injects them.
# TRUSTED_ORIGINS=https://idlebot.example
